<div class="notice-region" aria-live="polite" aria-atomic="true">
    @if (Notice is { } notice)
    {
        <div class="notice notice-@notice.Tone.ToString().ToLowerInvariant()" role="@(notice.Tone == NoticeTone.Error ? "alert" : "status")" data-testid="notice">
            <svg class="notice-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                @if (notice.Tone == NoticeTone.Error)
                {
                    <path d="M10 2.5 18.5 17h-17L10 2.5Z" class="icon-stroke" />
                    <path d="M10 8v4M10 14.5v.5" class="icon-stroke" />
                }
                else
                {
                    <circle cx="10" cy="10" r="7.5" class="icon-stroke" />
                    <path d="m6.5 10.2 2.3 2.3 4.7-5" class="icon-stroke" />
                }
            </svg>
            <p>@notice.Message</p>
            @if (notice.CanUndo)
            {
                <button type="button" class="btn btn-small btn-quiet" @onclick="OnUndo">Undo</button>
            }
            <button type="button" class="icon-btn" aria-label="Dismiss message" @onclick="OnDismiss">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m5 5 10 10M15 5 5 15" class="icon-stroke" /></svg>
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Notice? Notice { get; set; }
    [Parameter, EditorRequired] public EventCallback OnUndo { get; set; }
    [Parameter, EditorRequired] public EventCallback OnDismiss { get; set; }
}
