@inject IDomInterop Browser

<div class="month-head">
    @if (_renaming)
    {
        <div class="rename">
            <label for="rename-month" class="sr-only">Month name</label>
            <input id="rename-month" class="input input-title" maxlength="@LedgerOps.MaxNameLength" @bind="_draft" @bind:event="oninput" @onkeydown="OnKey" />
            <button type="button" class="btn btn-primary btn-small" @onclick="Save">Save</button>
            <button type="button" class="btn btn-quiet btn-small" @onclick="() => _renaming = false">Cancel</button>
        </div>
    }
    else
    {
        <h2 class="month-title" data-testid="month-title">@Month.Name</h2>
        <div class="month-actions">
            <button type="button" class="icon-btn" aria-label="@($"Rename {Month.Name}")" title="Rename month" @onclick="StartRename">
                <Icon Name="IconName.Edit" />
            </button>
            <button type="button" class="icon-btn icon-danger" aria-label="@($"Delete {Month.Name}")" title="Delete month" @onclick="() => Store.DeleteMonthAsync(Month.Id)">
                <Icon Name="IconName.Trash" />
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public LedgerStore Store { get; set; } = default!;
    [Parameter, EditorRequired] public Month Month { get; set; } = default!;

    private bool _renaming;
    private string _draft = "";
    private string? _monthId;

    protected override void OnParametersSet()
    {
        if (_monthId != Month.Id)
        {
            _monthId = Month.Id;
            _renaming = false;
        }
    }

    private async Task StartRename()
    {
        _draft = Month.Name;
        _renaming = true;
        StateHasChanged();
        await Task.Yield();
        await Browser.FocusAsync("rename-month", select: true);
    }

    private async Task Save()
    {
        _renaming = false;
        await Store.RenameMonthAsync(Month.Id, _draft);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Task.Yield();
            await Save();
        }
        else if (e.Key == "Escape")
        {
            _renaming = false;
        }
    }
}
