@inject BrowserBridge Browser

<section class="card entries" aria-labelledby="entries-title">
    <div class="card-head">
        <h2 id="entries-title">Entries <span class="count">@Month.Entries.Count</span></h2>
    </div>

    <div class="filters">
        <div class="search">
            <label for="entry-search" class="sr-only">Search entries</label>
            <svg class="search-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="5.5" class="icon-stroke" /><path d="m13 13 4 4" class="icon-stroke" /></svg>
            <input id="entry-search" type="search" class="input" placeholder="Search" autocomplete="off"
                   @bind="_query" @bind:event="oninput" data-testid="search" />
        </div>
        <label for="entry-filter" class="sr-only">Filter by category</label>
        <select id="entry-filter" class="input select" @bind="_filter" data-testid="filter">
            <option value="">All categories</option>
            @foreach (var c in Store.Ledger.Categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
            <option value="@NoCategory">No category</option>
        </select>
    </div>

    @{
        var visible = Month.Entries.Where(Matches).ToList();
        var filtering = !string.IsNullOrWhiteSpace(_query) || _filter.Length > 0;
    }

    @if (Month.Entries.Count == 0)
    {
        <p class="empty">Nothing in @Month.Name yet. Use Quick add above.</p>
    }
    else if (visible.Count == 0)
    {
        <p class="empty" role="status">No entries match. <button type="button" class="link" @onclick="ClearFilters">Clear filters</button></p>
    }
    else
    {
        @if (filtering)
        {
            <p class="filter-note" role="status">@visible.Count of @Month.Entries.Count entries · @Money.Format(visible.Where(e => e.IsSpending).Sum(e => e.Amount)) spent</p>
        }
        @foreach (var (kind, title, hint) in Groups)
        {
            var rows = visible.Where(e => e.Kind == kind).ToList();
            if (rows.Count == 0)
            {
                continue;
            }
            <div class="group">
                <div class="group-head">
                    <h3>@title</h3>
                    <span class="group-hint">@hint</span>
                    <span class="group-total @(kind == EntryKind.Income ? "tone-good" : "")">@Money.Format(rows.Sum(e => e.Amount))</span>
                </div>
                <ul class="rows" aria-label="@title">
                    @foreach (var e in rows)
                    {
                        var category = Store.Ledger.FindCategory(e.CategoryId);
                        <li class="row @(_editing?.Id == e.Id ? "is-editing" : "")" data-testid="entry-row">
                            @if (_editing?.Id == e.Id)
                            {
                                <div class="edit-grid" @onkeydown="OnEditKey">
                                    <div class="field">
                                        <label class="field-label" for="edit-name">Description</label>
                                        <input id="edit-name" class="input" maxlength="80" @bind="_editing.Name" @bind:event="oninput" />
                                    </div>
                                    <div class="field">
                                        <label class="field-label" for="edit-amount">Amount (R)</label>
                                        <input id="edit-amount" class="input input-num" inputmode="decimal" @bind="_editAmount" @bind:event="oninput" aria-invalid="@(_editError is null ? "false" : "true")" />
                                    </div>
                                    <div class="field">
                                        <label class="field-label" for="edit-kind">Type</label>
                                        <select id="edit-kind" class="input select" @bind="_editing.Kind">
                                            <option value="@EntryKind.Expense">Expense</option>
                                            <option value="@EntryKind.Recurring">Recurring</option>
                                            <option value="@EntryKind.Income">Income</option>
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label class="field-label" for="edit-category">Category</label>
                                        <select id="edit-category" class="input select" @bind="EditCategory" disabled="@(_editing.Kind == EntryKind.Income)">
                                            <option value="">No category</option>
                                            @foreach (var c in Store.Ledger.Categories)
                                            {
                                                <option value="@c.Id">@c.Name</option>
                                            }
                                        </select>
                                    </div>
                                    @if (_editError is not null)
                                    {
                                        <p class="hint hint-error edit-error" role="alert">@_editError</p>
                                    }
                                    <div class="edit-actions">
                                        <button type="button" class="btn btn-quiet btn-small" @onclick="CancelEdit">Cancel</button>
                                        <button type="button" class="btn btn-primary btn-small" @onclick="SaveEdit" data-testid="save-edit">Save</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <Swatch Category="@(e.Kind == EntryKind.Income ? null : category)" />
                                <div class="row-main">
                                    <span class="row-name">@(string.IsNullOrWhiteSpace(e.Name) ? "Untitled" : e.Name)</span>
                                    <span class="row-meta">@(e.Kind == EntryKind.Income ? "Income" : category?.Name ?? "No category")</span>
                                </div>
                                <span class="row-amount @(e.Kind == EntryKind.Income ? "tone-good" : "")">@Money.Format(e.Amount)</span>
                                <div class="row-actions">
                                    <button type="button" class="icon-btn" aria-label="@($"Edit {e.Name}")" @onclick="() => StartEdit(e)">
                                        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M13.5 3.5 16.5 6.5 7 16H4v-3l9.5-9.5Z" class="icon-stroke" /></svg>
                                    </button>
                                    <button type="button" class="icon-btn icon-danger" aria-label="@($"Delete {e.Name}")" @onclick="() => Store.DeleteEntryAsync(e.Id)">
                                        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m5.5 5.5 9 9M14.5 5.5l-9 9" class="icon-stroke" /></svg>
                                    </button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public LedgerStore Store { get; set; } = default!;
    [Parameter, EditorRequired] public Month Month { get; set; } = default!;

    private const string NoCategory = "__none";

    private static readonly (EntryKind, string, string)[] Groups =
    [
        (EntryKind.Income, "Income", "Money in"),
        (EntryKind.Recurring, "Recurring", "Carried into each new month"),
        (EntryKind.Expense, "Expenses", "This month only")
    ];

    private string _query = "";
    private string _filter = "";
    private Entry? _editing;
    private string _editAmount = "";
    private string? _editError;
    private string? _monthId;

    private string EditCategory
    {
        get => _editing?.CategoryId ?? "";
        set
        {
            if (_editing is not null)
            {
                _editing.CategoryId = value.Length == 0 ? null : value;
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (_monthId != Month.Id)
        {
            _monthId = Month.Id;
            _editing = null;
        }
        if (_filter.Length > 0 && _filter != NoCategory && Store.Ledger.FindCategory(_filter) is null)
        {
            _filter = "";
        }
    }

    private bool Matches(Entry e)
    {
        var category = Store.Ledger.FindCategory(e.CategoryId);
        if (_filter == NoCategory && (category is not null || e.Kind == EntryKind.Income))
        {
            return false;
        }
        if (_filter.Length > 0 && _filter != NoCategory && category?.Id != _filter)
        {
            return false;
        }
        var q = _query.Trim();
        return q.Length == 0
            || e.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (category?.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || Money.FormatPlain(e.Amount).Contains(q.Replace(" ", "").Replace(",", "."), StringComparison.Ordinal);
    }

    private void ClearFilters()
    {
        _query = "";
        _filter = "";
    }

    private async Task StartEdit(Entry e)
    {
        _editing = e.Clone();
        _editAmount = Money.FormatPlain(e.Amount);
        _editError = null;
        StateHasChanged();
        await Task.Yield();
        await Browser.FocusAsync("edit-name", select: true);
    }

    private void CancelEdit()
    {
        _editing = null;
        _editError = null;
    }

    private async Task SaveEdit()
    {
        if (_editing is null)
        {
            return;
        }
        if (!Money.TryParse(_editAmount, out var amount))
        {
            _editError = $"“{_editAmount.Trim()}” is not an amount. Use numbers like 120 or 89.95.";
            return;
        }
        _editing.Amount = amount;
        var saved = _editing;
        _editing = null;
        _editError = null;
        await Store.UpdateEntryAsync(saved);
    }

    private async Task OnEditKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveEdit();
        }
        else if (e.Key == "Escape")
        {
            CancelEdit();
        }
    }
}
