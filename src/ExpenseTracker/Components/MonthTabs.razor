@inject IDomInterop Browser

<nav class="months" aria-label="Months">
    <div class="month-strip" role="tablist" aria-label="Months, newest first">
        @foreach (var m in Months)
        {
            var selected = m.Id == SelectedId;
            <button type="button"
                    id="@($"tab-{m.Id}")"
                    role="tab"
                    class="month-tab @(selected ? "is-active" : "")"
                    aria-selected="@(selected ? "true" : "false")"
                    aria-controls="month-panel"
                    tabindex="@(selected ? 0 : -1)"
                    @onclick="() => OnSelect.InvokeAsync(m.Id)"
                    @onkeydown="e => OnKey(e, m.Id)">
                @m.Name
            </button>
        }
    </div>
    <button type="button" class="btn btn-ghost new-month" @onclick="OnAdd" data-testid="new-month">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 4v12M4 10h12" class="icon-stroke" /></svg>
        New month
    </button>
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Month> Months { get; set; } = [];
    [Parameter, EditorRequired] public string? SelectedId { get; set; }
    [Parameter, EditorRequired] public EventCallback<string> OnSelect { get; set; }
    [Parameter, EditorRequired] public EventCallback OnAdd { get; set; }

    private async Task OnKey(KeyboardEventArgs e, string monthId)
    {
        var index = Months.ToList().FindIndex(m => m.Id == monthId);
        var target = e.Key switch
        {
            "ArrowRight" => Math.Min(index + 1, Months.Count - 1),
            "ArrowLeft" => Math.Max(index - 1, 0),
            "Home" => 0,
            "End" => Months.Count - 1,
            _ => -1
        };
        if (target < 0 || target == index)
        {
            return;
        }
        var targetId = Months[target].Id;
        await OnSelect.InvokeAsync(targetId);
        await Browser.FocusAsync($"tab-{targetId}");
    }
}
